+static inline bool ksmbd_conn_rx_tx_pending(struct ksmbd_conn *conn)
+{
+	/* Wakeup hint only; the drain revalidates ownership under write_tx_lock. */
+	return conn->write_tx_rx_owner && READ_ONCE(conn->write_tx_active) &&
+		!READ_ONCE(conn->write_tx_deferred);
+}
 
