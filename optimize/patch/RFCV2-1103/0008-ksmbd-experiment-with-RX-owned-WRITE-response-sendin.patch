@@ -506,6 +527,15 @@ int ksmbd_conn_wait_idle_sess(struct ksmbd_conn *curr_conn,
 #define KSMBD_WRITE_TX_FRAME_SIZE 256
 #define KSMBD_WRITE_TX_BUDGET 64
 
+/* Backing storage survives a partial send and a handoff to write_tx_work. */
+struct ksmbd_write_tx_batch {
+	struct kvec iov[KSMBD_WRITE_TX_FRAMES * KSMBD_WRITE_TX_IOVS];
+	struct ksmbd_work *frames[KSMBD_WRITE_TX_FRAMES];
+	struct ksmbd_transport_write tx;
+	struct iov_iter iter;
+	unsigned int nr;
+};
+
 static bool ksmbd_write_tx_eligible(struct ksmbd_work *work)
 {
 	size_t size, total = 0;
@@ -529,82 +559,169 @@ static bool ksmbd_write_tx_eligible(struct ksmbd_work *work)
 	return total == size;
 }
 
+static void ksmbd_release_write_batch(struct ksmbd_write_tx_batch *batch,
+				      struct ksmbd_work *inline_work)
+{
+	unsigned int i;
+
+	for (i = 0; i < batch->nr; i++) {
+		/* Its original callback releases the inline owner's own work. */
+		if (batch->frames[i] != inline_work)
+			ksmbd_finish_work(batch->frames[i]);
+	}
+	batch->nr = 0;
+}
+
+static void ksmbd_wake_rx_tx(struct ksmbd_conn *conn)
+{
+	ksmbd_tcp_wake_rx(conn->transport);
+	wake_up_all(&conn->req_running_q);
+	wake_up_all(&conn->r_count_q);
+}
+
+static void ksmbd_write_tx_error(struct ksmbd_conn *conn, int error)
+{
+	pr_err("Failed to send WRITE responses: %d\n", error);
+	spin_lock(&conn->write_tx_lock);
+	conn->write_tx_failed = true;
+	spin_unlock(&conn->write_tx_lock);
+}
+
+/* False defers this batch to the TX worker; RX retains the owner reference. */
+static bool ksmbd_try_send_rx_tx(struct ksmbd_conn *conn,
+				 struct ksmbd_write_tx_batch *batch)
+{
+	bool locked;
+	int ret;
+
+	iov_iter_kvec(&batch->iter, ITER_SOURCE, batch->iov,
+		      batch->tx.iov_cnt, batch->tx.size);
+	locked = mutex_trylock(&conn->srv_mutex);
+	if (locked) {
+		ret = ksmbd_tcp_send_iter(conn->transport, &batch->iter, MSG_DONTWAIT);
+		if (ret <= 0 && ret != -EAGAIN) {
+			conn->transport->ops->shutdown(conn->transport);
+			ksmbd_write_tx_error(conn, ret ?: -EIO);
+		} else if (iov_iter_count(&batch->iter)) {
+			goto defer;
+		}
+		ksmbd_conn_unlock(conn);
+		return true;
+	}
+defer:
+	/* Reserve a partial frame before releasing its serialization lock. */
+	spin_lock(&conn->write_tx_lock);
+	WRITE_ONCE(conn->write_tx_deferred, true);
+	spin_unlock(&conn->write_tx_lock);
+	if (locked)
+		ksmbd_conn_unlock(conn);
+	WARN_ON_ONCE(!queue_work(ksmbd_tx_wq, &conn->write_tx_work));
+	return false;
+}
