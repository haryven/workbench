 					WQ_UNBOUND | WQ_MEM_RECLAIM, 0);
 	if (!ksmbd_conn_wq)
 		return -ENOMEM;
+	if (write_tx_rx_owner) {
+		/* Send waiters must not consume the continuation's active slots. */
+		ksmbd_tx_wq = alloc_workqueue("ksmbd-tx", WQ_UNBOUND, 0);
+		if (!ksmbd_tx_wq) {
+			destroy_workqueue(ksmbd_conn_wq);
+			ksmbd_conn_wq = NULL;
+			return -ENOMEM;
