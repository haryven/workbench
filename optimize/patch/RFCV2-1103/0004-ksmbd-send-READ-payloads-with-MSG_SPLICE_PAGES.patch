+static bool ksmbd_alloc_read_pages(struct aux_read *ar, size_t length)
+{
+	gfp_t gfp = GFP_KERNEL | __GFP_NORETRY | __GFP_NOWARN;
+	unsigned int nr_pages = DIV_ROUND_UP(length, PAGE_SIZE);
+	unsigned int order = PAGE_FRAG_CACHE_MAX_ORDER;
+	unsigned int whole_order = get_order(length);
+	unsigned int i;
+
+	ar->bvec = kvcalloc(nr_pages + 1, sizeof(*ar->bvec), gfp);
+	if (!ar->bvec)
+		return false;
+
+	/* Try one allocation without reclaim, then fall back to small pages. */
+	if (whole_order > order && whole_order <= MAX_PAGE_ORDER) {
+		struct page *page;
+
+		page = alloc_pages((gfp & ~__GFP_RECLAIM) | __GFP_COMP,
+				   whole_order);
+		if (page) {
+			bvec_set_page(&ar->bvec[1], page, length, 0);
+			ar->nr_bvec = 1;
+			return true;
+		}
+	}
+
+	/*
+	 * Each bvec owns one small allocation. Larger folios are optional:
+	 * do not reclaim for them, and use base pages after the first failure.
+	 */
+	while (length) {
+		struct page *page;
+		size_t len;
+
+		while (order && length < (PAGE_SIZE << order))
+			order--;
+		page = alloc_pages((order ? gfp & ~__GFP_DIRECT_RECLAIM : gfp) |
+				   __GFP_COMP, order);
+		if (!page) {
+			if (order) {
+				order = 0;
+				continue;
+			}
+			goto free_pages;
+		}
+
+		len = min_t(size_t, length, PAGE_SIZE << order);
+		bvec_set_page(&ar->bvec[++ar->nr_bvec], page, len, 0);
+		length -= len;
+	}
+	return true;
+
+free_pages:
+	for (i = 1; i <= ar->nr_bvec; i++)
+		put_page(ar->bvec[i].bv_page);
+	ar->nr_bvec = 0;
+	kvfree(ar->bvec);
+	ar->bvec = NULL;
+	return false;
+}
+
+struct aux_read *ksmbd_alloc_read_buf(size_t length, bool allow_splice)
+{
+	struct aux_read *ar;
+	size_t alloc_size = ALIGN(length, 8);
+
+	ar = kzalloc_obj(*ar, KSMBD_DEFAULT_GFP);
+	if (!ar)
+		return NULL;
+
+	if (allow_splice && length && ksmbd_alloc_read_pages(ar, length))
+		return ar;
+	ar->buf = kvmalloc(alloc_size, KSMBD_DEFAULT_GFP);
+	if (!ar->buf) {
+		kfree(ar);
+		return NULL;
+	}
+	return ar;
+}
+
+/* Drop unused pages after a short READ and initialize any alignment padding. */
+void ksmbd_read_buf_set_size(struct aux_read *ar, size_t size)
+{
+	void *tail = ar->buf;
+	unsigned int nr_bvec = 0, i;
+	size_t tail_size = size;
+
+	if (ar->bvec) {
+		for (i = 1; i <= ar->nr_bvec; i++) {
+			struct bio_vec *bv = &ar->bvec[i];
+
+			if (!size) {
+				put_page(bv->bv_page);
+				continue;
+			}
+			bv->bv_len = min_t(size_t, size, bv->bv_len);
+			size -= bv->bv_len;
+			nr_bvec++;
+			tail_size = bv->bv_len;
+			tail = page_address(bv->bv_page);
+		}
+		ar->nr_bvec = nr_bvec;
+		if (!nr_bvec)
+			return;
+	}
+	if (tail_size & 7)
+		memset(tail + tail_size, 0, ALIGN(tail_size, 8) - tail_size);
+}
+
+void ksmbd_free_read_buf(struct aux_read *ar)
+{
+	unsigned int i;
+
+	if (!ar)
+		return;
+	/* TCP may still own references; never reuse or modify these pages. */
+	for (i = 0; i < ar->nr_bvec; i++)
+		put_page(ar->bvec[i + 1].bv_page);
+	kvfree(ar->bvec);
+	kvfree(ar->buf);
+	kfree(ar);
+}
