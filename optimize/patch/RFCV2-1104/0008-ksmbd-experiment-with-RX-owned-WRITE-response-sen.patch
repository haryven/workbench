+static void ksmbd_resume_rx_tx(struct ksmbd_conn *conn)
+{
+	struct ksmbd_work *work = conn->write_tx_pending;
+	int ret;
+
+	/* TCP's existing writable wait runs here, never in the receiver. */
+	ksmbd_conn_lock(conn);
+	while (iov_iter_count(&conn->write_tx_iter)) {
+		ret = ksmbd_tcp_send_iter(conn->transport, &conn->write_tx_iter, 0);
+		if (ret <= 0) {
+			conn->transport->ops->shutdown(conn->transport);
+			ksmbd_write_tx_error(conn, ret ?: -EIO);
+			break;
+		}
+	}
+	ksmbd_conn_unlock(conn);
+	conn->write_tx_pending = NULL;
+	ksmbd_finish_work(work);
+	spin_lock(&conn->write_tx_lock);
+	WRITE_ONCE(conn->write_tx_state, KSMBD_WRITE_TX_DRAINING);
+	/* RX rechecks the queue under lock and releases the owner reference. */
+	ksmbd_wake_rx_tx(conn);
+	spin_unlock(&conn->write_tx_lock);
+}
+
 static void ksmbd_write_tx_work(struct work_struct *wk)
 {
 	struct ksmbd_conn *conn = container_of(wk, struct ksmbd_conn, write_tx_work);
 
-	ksmbd_drain_write_tx(conn, NULL);
+	if (conn->write_tx_rx_owner)
+		ksmbd_resume_rx_tx(conn);
+	else
+		ksmbd_drain_write_tx(conn, NULL);
 }
 
 static void ksmbd_init_write_tx(struct ksmbd_conn *conn)
@@ -612,6 +731,26 @@ static void ksmbd_init_write_tx(struct ksmbd_conn *conn)
 	spin_lock_init(&conn->write_tx_lock);
 	INIT_LIST_HEAD(&conn->write_tx_list);
 	INIT_WORK(&conn->write_tx_work, ksmbd_write_tx_work);
+	conn->write_tx_rx_owner = write_tx_rx_owner &&
+		ksmbd_transport_is_tcp(conn->transport);
+}
+
+void ksmbd_conn_drain_rx_tx(struct ksmbd_conn *conn)
+{
+	if (ksmbd_conn_rx_tx_pending(conn))
+		ksmbd_drain_write_tx(conn, NULL);
+}
+
+static void ksmbd_finish_rx_tx(struct ksmbd_conn *conn)
+{
+	if (!conn->write_tx_rx_owner)
+		return;
+	/* A receive EOF need not close the send half. Finish accepted requests. */
+	while (atomic_read(&conn->r_count)) {
+		ksmbd_conn_drain_rx_tx(conn);
+		wait_event(conn->r_count_q, !atomic_read(&conn->r_count) ||
+			   ksmbd_conn_rx_tx_pending(conn));
+	}
 }
 
